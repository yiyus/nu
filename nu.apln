⍝ characters
  ∇ r←TAB
    r←⎕UCS 9
  ∇
  ∇ r←LF
    r←⎕UCS 10
  ∇
  ∇ r←CR
    r←⎕UCS 13
  ∇
  ∇ r←CRLF
    r←⎕UCS 13 10
  ∇
  _NL←⎕UCS 13,⍣('Windows'≡'-64'~⍨⊃#⎕WG'APLVersion')⊢10
  ∇ r←NL
    r←_NL
  ∇

⍝ aliases
   _aliases←'head' 'grep' 'vgrep' 'grepn' 'sort' 'cat' 'tee' 'teea' '''git''exec'
   ('hfdnscta',⊂'git'){⍎⍺,'←{(~DEBUG)/0::⎕SIGNAL kill⎕DMX ⋄ ⍺←⊢ ⋄ ⍺(',⍵,')⍵}'}¨_aliases
   ∇ r←{a}git w
     :If 0=⎕NC'a' ⋄ a←⊢ ⋄ :EndIf ⋄ r←↑a('git'exec)w
   ∇

⍝ manual
  _man ←⊂'NOT UNIX'
  _man,←⊂''
  _man,←⊂'Files and processes'
  _man,←⊂''
  _man,←⊂'         ... cd d1 ...   change to d1/..., return ⍺ pushing current dir, empty by default'
  _man,←⊂''
  _man,←⊂'      d1 ... ls f1 ...   list f1 ... from d1/..., default .'
  _man,←⊂'    d1 ... find f1 ...   list f1 ... from d1/... recursively, default . (full paths)'
  _man,←⊂'     n ... date f1 ...   modification date of f1 ... or list elements in f1 ... newer than n ...'
  _man,←⊂'           n du f1 ...   size of f1 ... or list elements in f1 ... larger than n'
  _man,←⊂'           n lc f1 ...   format list f1 ... by columns in max n rows, default 10'
  _man,←⊂'           n ll f1 ...   format full list f1 ... as list of max n rows sorted by size, default 16'
  _man,←⊂''
  _man,←⊂'      f2 ... mv f1 ...   move f1 ... to f2 ... (scalar extension), default BIN, mv BIN to empty'
  _man,←⊂'      f2 ... cp f1 ...   copy f1 ... to f2 ... (scalar extension), default .'
  _man,←⊂'      d1 ... mk fn ...   make fn pipes or create fn ... in d1/..., default . (empty for temp)'
  _man,←⊂''
  _man,←⊂'            ... sh ...   run shell command ⍵ or shell command ⍺ with stdin ⍵, empty for repl'
  _man,←⊂'            ... bg ...   run shell command in a different thread and return stdout pipe'
  _man,←⊂'       ...(⍺⍺ exec)...   exec command ⍺⍺ with arguments ⍵ or with arguments ⍺ and input ⍵'
  _man,←⊂'       ...(⍺⍺ fork)...   exec in a different thread and return stdout pipe'
  _man,←⊂'              kill ...   kill thread or close pipe, ''*'' to kill all threads'
  _man,←⊂''
  _man,←⊂'    with f1 ..., f2 ... file or dir paths (right arg f1 ... may include wildcards, empty is .),'
  _man,←⊂'    d1 ... dir names (path components), n ... numbers, and fn file or dir name or integer'
  _man,←⊂''
  _man,←⊂'    HOME is the home directory. TMP is the system temp dir. BIN is nu''s recycle bin dir'
  _man,←⊂''
  _man,←⊂'Text editing'
  _man,←⊂''
  _man,←⊂'             t2 cat t1   concatenate contents of t1 and t2, default ⍬'
  _man,←⊂'             n head t1   format first n lines of t1 as matrix, default 10'
  _man,←⊂'             n tail t1   format last n lines of t1 as matrix, default 10'
  _man,←⊂'            ⍺  sort t1   ascending sort lines of t1 according to ⍺, default t1'
  _man,←⊂'            ⍺ rsort t1   (sort -r) descending sort lines of t1 according to ⍺, default t1'
  _man,←⊂'            r  grep t1   get lines of t1 matching s, default files'
  _man,←⊂'            r vgrep t1   (grep -v) get lines of t1 not matching s, default files (return dirs)'
  _man,←⊂'             f  tee t1   write t1 to f and return it, pipes are closed, default ⎕'
  _man,←⊂'             f teea t1   (tee -a) append t1 to f and return it, pipes are not closed, default ⍞'
  _man,←⊂'               r wc t1   count occurences of r in t1, default \S+ (words)'
  _man,←⊂'              r wcl t1   (wc -l) count lines with occurences of r in t1, default .* (all lines)'
  _man,←⊂'          s ... sed t1   apply substitution pattern /a/b/... (or |a|b|.., etc), default -\s+$'
  _man,←⊂'          ...(⍺⍺ ed)f1   apply ⍺∘⍺⍺ on f and write back to f, ⍺⍺ string to run with exec, default ⊢'
  _man,←⊂''
  _man,←⊂'      ⍺(⍺⍺ x ⍵⍵)s1 ...   substitute by ⍺⍺ or apply ⍺∘⍺⍺ on matches of ⍵⍵ in s, default ⊢'
  _man,←⊂'      ⍺(⍺⍺ y ⍵⍵)s1 ...   substitute by ⍺⍺ or apply ⍺∘⍺⍺ between matches of ⍵⍵ in s, default ⊢'
  _man,←⊂'                         (right function to x or y to apply ⍺ to matches or non-matches of ⍺⍺)'
  _man,←⊂'      ⍺(⍺⍺ g ⍵⍵)s1 ...   apply ⍺∘⍺⍺ s if s matches ⍵⍵, default ⊢'
  _man,←⊂'      ⍺(⍺⍺ v ⍵⍵)s1 ...   apply ⍺∘⍺⍺ s if s does not match ⍵⍵, default ⊢'
  _man,←⊂'                         (right function to g or v to apply ⍺ to lines matching or not ⍺⍺)'
  _man,←⊂'         s2 cut s1 ...   split ⍵ at occurences of ⍺, empty for whitespace, default linebreak'
  _man,←⊂'        s2 join s1 ...   join elements of ⍵ with ⍺, default NL or empty'
  _man,←⊂''
  _man,←⊂'    with t1 t2 path or glob string, or matrix, or list of lines, or pipe (negated to not close),'
  _man,←⊂'    n number, r regex string, s s1 s2 ... strings, f1 file name'
  _man,←⊂''
  _man,←⊂'    The variables TAB CR LF contain tab, carriage return and linefeed characters.'
  _man,←⊂'    CRLF is the windows new line, and NL the native one (LF or CRLF)'
  _man,←⊂''
  _man,←⊂'SEE ALSO: unix, gnu, plan 9'
  
  ∇ r←man
    r←↑_man
  ∇

0⎕EXPORT('_'=⊃¨)⍛/⎕NL-3 4
⎕DF'[~unix]'

